{
  "name": "geo-data",
  "version": "2.3.0",
  "description": "Monorepo for managing Geo data within the E-PICSA App",
  "main": "index.js",
  "scripts": {
    "start": "concurrently --names \"API,WEB\" --prefix-colors \"cyan,magenta\" \"npm:start:api\" \"npm:start:web\"",
    "start:api": "cd api && bun run start -- --no-clear && cd ../.",
    "start:web": "cd web && bun run start -- --clearScreen false && cd ../",
    "test": "bun test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,cjs,js,json,md,css,scss}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,cjs,js,json,md,css,scss}\"",
    "update:osm-levels": "bun scripts/update-osm-admin-levels.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,scss}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/e-picsa/geo-data.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/e-picsa/geo-data/issues"
  },
  "homepage": "https://github.com/e-picsa/geo-data#readme",
  "devDependencies": {
    "@eslint/js": "^9.3.0",
    "concurrently": "^8.2.2",
    "country-list": "^2.4.1",
    "eslint": "^9.3.0",
    "eslint-config-prettier": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5",
    "typescript-eslint": "^7.9.0"
  },
  "workspaces": [
    "api",
    "web"
  ]
}
